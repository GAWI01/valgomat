{
  "name": "valgomat-2027",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Valgomat 2027 – en transparent og kildebasert norsk valgomat",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "audit": "node scripts/build-audit.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run data && vitest run",
    "typecheck": "tsc -b",
    "qa:stress": "node scripts/qa/run-ts.mjs scripts/qa/stress.ts",
    "qa:clusters": "node scripts/qa/run-ts.mjs scripts/qa/clusters.ts",
    "qa:smoke": "node scripts/qa/smoke.mjs",
    "qa:watch": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/qa/watch-storting.mjs",
    "party-review": "node scripts/party-review.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
